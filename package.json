{
  "name": "schoolsafe-v2",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspace server",
    "test": "npm run test --workspace server",
    "ci": "node scripts/check-migration-versions.mjs && npm run check:permissions && npm run typecheck && npm test",
    "check:permissions": "node --test scripts/permission-contract.test.mjs",
    "check:migration-versions": "node scripts/check-migration-versions.mjs",
    "build:auth-sdk": "esbuild frontend/vendor/supabase-entry.js --bundle --format=iife --global-name=SchoolSafeSupabaseSDK --outfile=app/vendor/supabase-sdk.js",
    "check:auth-sdk": "node scripts/check-auth-bundle.mjs",
    "test:qa": "npx vitest run tests/qa/unit tests/qa/rls tests/qa/integration && npx playwright test tests/qa/e2e",
    "test:qa:rls": "npx vitest run tests/qa/rls",
    "test:e2e:profiles": "playwright test tests/qa/e2e",
    "test:e2e:existing": "node app/qa-smoke.cjs && node app/qa-pwa.cjs && node app/qa-i18n.cjs",
    "test:e2e:staging": "npm run test:e2e:existing",
    "test:jaspe-physical": "node --no-warnings --test app/qa-jaspe-presentation-controller.test.mjs && node app/qa-jaspe-physical-contract.cjs",
    "test:no-guardian-screen": "node app/qa-no-guardian-screen.cjs",
    "test:visual-system": "node app/qa-responsive-visual-system.cjs && node app/qa-no-guardian-screen.cjs",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "test:rls": "node scripts/run-rls-tests.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "0.28.2",
    "pg": "8.23.0",
    "playwright": "1.62.1",
    "supabase": "2.114.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  }
}
